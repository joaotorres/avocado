<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-gray-900">Assignments</h1>
    <% if policy(Assignment).create? %>
      <%= link_to "New Assignment", new_company_assignment_path(@company), class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out" %>
    <% end %>
  </div>

  <% if notice.present? %>
    <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-6" role="alert">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-md rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Driver</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vehicle</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @assignments.any? %>
          <% @assignments.each do |assignment| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= assignment.date.strftime("%B %d, %Y") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= assignment.driver.name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= assignment.vehicle.make %> <%= assignment.vehicle.model %> (<%= assignment.vehicle.license_plate %>)</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <%= link_to "View", company_assignment_path(@company, assignment), class: "text-blue-600 hover:text-blue-900 mr-3" %>
                <% if policy(assignment).update? %>
                  <%= link_to "Edit", edit_company_assignment_path(@company, assignment), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
                <% end %>
                <% if policy(assignment).destroy? %>
                  <%= button_to "Delete", company_assignment_path(@company, assignment), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-900" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4" class="px-6 py-8 text-center text-gray-500">
              No assignments found.
              <% if policy(Assignment).create? %>
                <%= link_to "Create your first assignment", new_company_assignment_path(@company), class: "text-blue-600 hover:text-blue-900" %>.
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
