<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Assignments", company_assignments_path(@company), class: "text-blue-600 hover:text-blue-900" %>
  </div>

  <% if notice.present? %>
    <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-6" role="alert">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-md rounded-lg overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
      <h1 class="text-3xl font-bold text-gray-900">Assignment Details</h1>
    </div>

    <div class="px-6 py-6">
      <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Date</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @assignment.date.strftime("%B %d, %Y") %></dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Company</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @assignment.company.name %></dd>
        </div>

        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-gray-500">Driver</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= @assignment.driver.name %>
            <span class="text-xs text-gray-500">(<%= @assignment.driver.email %>)</span>
          </dd>
        </div>

        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-gray-500">Vehicle</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= @assignment.vehicle.year %> <%= @assignment.vehicle.make %> <%= @assignment.vehicle.model %>
            <span class="text-xs text-gray-500">(<%= @assignment.vehicle.license_plate %>)</span>
          </dd>
        </div>
      </dl>
    </div>

    <%# Incident section %>
    <% incident = @assignment.vehicle.incidents.find_by(date: @assignment.date) %>
    <div class="px-6 py-6 border-t border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Incident Report</h2>

      <% if incident.present? %>
        <div class="bg-orange-50 border border-orange-200 rounded-lg p-4">
          <dl class="grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2">
            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Category</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= incident.category_name %></dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Status</dt>
              <dd class="mt-1">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                  <%= case incident.status
                      when 'open' then 'bg-yellow-100 text-yellow-800'
                      when 'in_progress' then 'bg-blue-100 text-blue-800'
                      when 'resolved' then 'bg-green-100 text-green-800'
                      when 'dismissed' then 'bg-gray-100 text-gray-800'
                      end %>">
                  <%= incident.status.humanize %>
                </span>
              </dd>
            </div>

            <div class="sm:col-span-1">
              <dt class="text-sm font-medium text-gray-500">Reporter</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= incident.reporter.name %></dd>
            </div>

            <% if incident.cost.present? %>
              <div class="sm:col-span-1">
                <dt class="text-sm font-medium text-gray-500">Cost</dt>
                <dd class="mt-1 text-sm text-gray-900">£<%= number_with_precision(incident.cost, precision: 2) %></dd>
              </div>
            <% end %>

            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500">Description</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= incident.description %></dd>
            </div>

            <div class="sm:col-span-2">
              <%= link_to "View Full Incident Details", company_incident_path(@company, incident), class: "text-orange-600 hover:text-orange-900 font-medium" %>
            </div>
          </dl>
        </div>
      <% else %>
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-center">
          <p class="text-sm text-gray-500">No incident reported for this assignment</p>
          <% if current_user.driver? && @assignment.driver_id == current_user.id %>
            <div class="mt-3">
              <%= link_to "Report Incident", new_company_incident_path(@company, assignment_id: @assignment.id), class: "text-orange-600 hover:text-orange-900 font-medium" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if policy(@assignment).update? || policy(@assignment).destroy? %>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-between">
        <% if policy(@assignment).update? %>
          <%= link_to "Edit", edit_company_assignment_path(@company, @assignment), class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out" %>
        <% end %>
        <% if policy(@assignment).destroy? %>
          <%= button_to "Delete", company_assignment_path(@company, @assignment), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this assignment?" }, class: "bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
