<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Companies", companies_path, class: "text-blue-600 hover:text-blue-900" %>
  </div>

  <% if notice.present? %>
    <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-6" role="alert">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-md rounded-lg overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
      <h1 class="text-3xl font-bold text-gray-900"><%= @company.name %></h1>
    </div>

    <div class="px-6 py-6">
      <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Company Name</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @company.name %></dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Number of Users</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @company.users.count %></dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Number of Vehicles</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @company.vehicles.count %></dd>
        </div>
      </dl>
    </div>

    <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-between">
      <div class="flex space-x-3">
        <%= link_to "View Vehicles", company_vehicles_path(@company), class: "bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out" %>
        <%= link_to "Edit", edit_company_path(@company), class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out" %>
      </div>
      <%= button_to "Delete", company_path(@company), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this company? This will delete all vehicles for this company." }, class: "bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out" %>
    </div>
  </div>
</div>
