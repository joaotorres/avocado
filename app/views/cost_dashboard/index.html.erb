<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-gray-900">Cost Dashboard</h1>
  </div>

  <% if @monthly_costs.any? %>
    <div class="bg-white shadow-md rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Month</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Incidents</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Cost</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @monthly_costs.each do |month_data| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= month_data[:date].strftime("%B %Y") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= month_data[:incident_count] %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium <%= month_data[:total_cost] > 0 ? 'text-red-600' : 'text-gray-500' %>">
                £<%= number_with_precision(month_data[:total_cost], precision: 2, delimiter: ',') %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <%= link_to "View Details",
                    company_cost_dashboard_month_path(@company, year: month_data[:date].year, month: month_data[:date].month),
                    class: "text-blue-600 hover:text-blue-900" %>
              </td>
            </tr>
          <% end %>
          <tr class="bg-gray-50 font-semibold">
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">Total</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= @monthly_costs.sum { |m| m[:incident_count] } %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-red-700">
              £<%= number_with_precision(@monthly_costs.sum { |m| m[:total_cost] }, precision: 2, delimiter: ',') %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm"></td>
          </tr>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white shadow-md rounded-lg p-8">
      <p class="text-gray-500 text-center">No vehicles or incidents found for this company yet.</p>
    </div>
  <% end %>
</div>
