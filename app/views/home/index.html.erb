<div class="min-h-screen bg-gradient-to-br from-green-50 to-emerald-100 flex items-center justify-center px-4 py-8">
  <div class="max-w-4xl w-full mx-auto">
    <div class="text-center">
      <h1 class="text-6xl font-bold text-green-600 mb-4">
        Avocado
      </h1>
      <p class="text-2xl text-gray-700 mb-8">
        Vehicle Fleet Management System
      </p>
      <p class="text-lg text-gray-600 mb-12 max-w-2xl mx-auto">
        Streamline your fleet operations with our comprehensive vehicle management platform.
        Track vehicles, manage companies, and empower your team with role-based access.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <%= link_to "Sign In", new_user_session_path, class: "inline-flex items-center px-8 py-4 border border-transparent text-lg font-medium rounded-lg text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition duration-150 ease-in-out shadow-lg" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "inline-flex items-center px-8 py-4 border border-green-600 text-lg font-medium rounded-lg text-green-600 bg-white hover:bg-green-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition duration-150 ease-in-out shadow-lg" %>
      </div>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white rounded-lg p-6 shadow-md">
        <div class="text-green-600 text-3xl mb-4">🚗</div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Vehicle Management</h3>
        <p class="text-gray-600">Track and manage your entire fleet with detailed vehicle information and history.</p>
      </div>

      <div class="bg-white rounded-lg p-6 shadow-md">
        <div class="text-green-600 text-3xl mb-4">🏢</div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Multi-Tenancy</h3>
        <p class="text-gray-600">Separate data by company with complete isolation and security.</p>
      </div>

      <div class="bg-white rounded-lg p-6 shadow-md">
        <div class="text-green-600 text-3xl mb-4">👥</div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Role-Based Access</h3>
        <p class="text-gray-600">Control access with admin, manager, and driver roles.</p>
      </div>
    </div>
  </div>
</div>
