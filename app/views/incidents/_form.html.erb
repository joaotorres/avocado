<%= form_with(model: [@company, incident], class: "space-y-6") do |form| %>
  <% if incident.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg" role="alert">
      <h2 class="font-bold mb-2"><%= pluralize(incident.errors.count, "error") %> prohibited this incident from being saved:</h2>
      <ul class="list-disc list-inside">
        <% incident.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-6">
    <div>
      <%= form.label :vehicle_id, "Vehicle", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.collection_select :vehicle_id,
          @company.vehicles.order(:make, :model),
          :id,
          ->(v) { "#{v.make} #{v.model} (#{v.license_plate})" },
          { prompt: "Select a vehicle" },
          { class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500", disabled: incident.persisted? } %>
      <% if incident.persisted? %>
        <p class="mt-1 text-xs text-gray-500">Vehicle cannot be changed after creation</p>
      <% end %>
    </div>

    <div>
      <%= form.label :date, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.date_field :date, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= form.label :category, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :category,
          Incident.categories.keys.map { |k| [Incident.human_category_name(k), k] },
          { prompt: "Select a category" },
          { class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" } %>
    </div>

    <div>
      <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :description, rows: 5, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500", placeholder: "Describe the incident in detail..." %>
    </div>

    <% if policy(incident).update? %>
      <div>
        <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :status,
            Incident.statuses.keys.map { |k| [k.humanize, k] },
            {},
            { class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" } %>
      </div>

      <div>
        <%= form.label :cost, "Estimated/Actual Cost", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :cost, step: 0.01, min: 0, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500", placeholder: "0.00" %>
      </div>
    <% end %>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", company_incidents_path(@company), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out" %>
    <%= form.submit class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out cursor-pointer" %>
  </div>
<% end %>
