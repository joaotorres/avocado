<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold text-gray-900">Incidents</h1>
  </div>

  <% if notice.present? %>
    <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-6" role="alert">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-md rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vehicle</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reporter</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @incidents.any? %>
          <% @incidents.each do |incident| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= incident.date.strftime("%b %d, %Y") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if current_user.manager? || current_user.admin? %>
                  <%= link_to company_vehicle_path(@company, incident.vehicle), class: "text-blue-600 hover:text-blue-900" do %>
                    <%= incident.vehicle.make %> <%= incident.vehicle.model %> (<%= incident.vehicle.license_plate %>)
                  <% end %>
                <% else %>
                  <%= incident.vehicle.make %> <%= incident.vehicle.model %> (<%= incident.vehicle.license_plate %>)
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= incident.category_name %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                  <%= case incident.status
                      when 'open' then 'bg-yellow-100 text-yellow-800'
                      when 'in_progress' then 'bg-blue-100 text-blue-800'
                      when 'resolved' then 'bg-green-100 text-green-800'
                      when 'dismissed' then 'bg-gray-100 text-gray-800'
                      end %>">
                  <%= incident.status.humanize %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if current_user.manager? || current_user.admin? %>
                  <%= link_to incident.reporter.name, company_driver_path(@company, incident.reporter), class: "text-blue-600 hover:text-blue-900" %>
                <% else %>
                  <%= incident.reporter.name %>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <%= link_to "View", company_incident_path(@company, incident), class: "text-blue-600 hover:text-blue-900 mr-3" %>
                <% if policy(incident).update? %>
                  <%= link_to "Edit", edit_company_incident_path(@company, incident), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
                <% end %>
                <% if policy(incident).destroy? %>
                  <%= button_to "Delete", company_incident_path(@company, incident), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-900" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="px-6 py-8 text-center text-gray-500">
              No incidents found.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
