<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Incidents", company_incidents_path(@company), class: "text-blue-600 hover:text-blue-900" %>
  </div>

  <% if notice.present? %>
    <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-6" role="alert">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-md rounded-lg overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
      <h1 class="text-3xl font-bold text-gray-900">Incident Details</h1>
    </div>

    <div class="px-6 py-6">
      <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Date</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @incident.date.strftime("%B %d, %Y") %></dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Status</dt>
          <dd class="mt-1">
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
              <%= case @incident.status
                  when 'open' then 'bg-yellow-100 text-yellow-800'
                  when 'in_progress' then 'bg-blue-100 text-blue-800'
                  when 'resolved' then 'bg-green-100 text-green-800'
                  when 'dismissed' then 'bg-gray-100 text-gray-800'
                  end %>">
              <%= @incident.status.humanize %>
            </span>
          </dd>
        </div>

        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-gray-500">Vehicle</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <% if current_user.manager? || current_user.admin? %>
              <%= link_to company_vehicle_path(@company, @incident.vehicle), class: "text-blue-600 hover:text-blue-900" do %>
                <%= @incident.vehicle.year %> <%= @incident.vehicle.make %> <%= @incident.vehicle.model %>
                <span class="text-xs text-gray-500">(<%= @incident.vehicle.license_plate %>)</span>
              <% end %>
            <% else %>
              <%= @incident.vehicle.year %> <%= @incident.vehicle.make %> <%= @incident.vehicle.model %>
              <span class="text-xs text-gray-500">(<%= @incident.vehicle.license_plate %>)</span>
            <% end %>
          </dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Category</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @incident.category_name %></dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Reporter</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <% if current_user.manager? || current_user.admin? %>
              <%= link_to company_driver_path(@company, @incident.reporter), class: "text-blue-600 hover:text-blue-900" do %>
                <%= @incident.reporter.name %>
                <span class="text-xs text-gray-500">(<%= @incident.reporter.email %>)</span>
              <% end %>
            <% else %>
              <%= @incident.reporter.name %>
              <span class="text-xs text-gray-500">(<%= @incident.reporter.email %>)</span>
            <% end %>
          </dd>
        </div>

        <% if @incident.cost.present? %>
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Cost</dt>
            <dd class="mt-1 text-sm text-gray-900">£<%= number_with_precision(@incident.cost, precision: 2) %></dd>
          </div>
        <% end %>

        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-gray-500">Description</dt>
          <dd class="mt-1 text-sm text-gray-900 whitespace-pre-wrap"><%= @incident.description %></dd>
        </div>

        <div class="sm:col-span-2 border-t pt-4">
          <dt class="text-sm font-medium text-gray-500">Reported</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @incident.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
        </div>
      </dl>
    </div>

    <% if policy(@incident).update? || policy(@incident).destroy? %>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-between">
        <% if policy(@incident).update? %>
          <%= link_to "Edit", edit_company_incident_path(@company, @incident), class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out" %>
        <% end %>
        <% if policy(@incident).destroy? %>
          <%= button_to "Delete", company_incident_path(@company, @incident), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this incident?" }, class: "bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
