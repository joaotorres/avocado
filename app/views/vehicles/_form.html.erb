<%= form_with(model: [@company, vehicle], class: "space-y-6") do |form| %>
  <% if vehicle.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg" role="alert">
      <h2 class="font-bold mb-2"><%= pluralize(vehicle.errors.count, "error") %> prohibited this vehicle from being saved:</h2>
      <ul class="list-disc list-inside">
        <% vehicle.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :make, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :make, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= form.label :model, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :model, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= form.label :year, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :year, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= form.label :color, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :color, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= form.label :license_plate, "License Plate", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :license_plate, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= form.label :vin, "VIN", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :vin, class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", company_vehicles_path(@company), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out" %>
    <%= form.submit class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out cursor-pointer" %>
  </div>
<% end %>
