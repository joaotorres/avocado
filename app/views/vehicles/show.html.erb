<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Vehicles", company_vehicles_path(@company), class: "text-blue-600 hover:text-blue-900" %>
  </div>

  <% if notice.present? %>
    <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-6" role="alert">
      <%= notice %>
    </div>
  <% end %>

  <div class="bg-white shadow-md rounded-lg overflow-hidden">
    <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
      <h1 class="text-3xl font-bold text-gray-900"><%= @vehicle.year %> <%= @vehicle.make %> <%= @vehicle.model %></h1>
    </div>

    <div class="px-6 py-6">
      <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Make</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @vehicle.make %></dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Model</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @vehicle.model %></dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Year</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @vehicle.year %></dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">Color</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @vehicle.color %></dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">License Plate</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @vehicle.license_plate %></dd>
        </div>

        <div class="sm:col-span-1">
          <dt class="text-sm font-medium text-gray-500">VIN</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @vehicle.vin %></dd>
        </div>
      </dl>
    </div>

    <% if policy(@vehicle).update? || policy(@vehicle).destroy? %>
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-between">
        <% if policy(@vehicle).update? %>
          <%= link_to "Edit", edit_company_vehicle_path(@company, @vehicle), class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out" %>
        <% end %>
        <% if policy(@vehicle).destroy? %>
          <%= button_to "Delete", company_vehicle_path(@company, @vehicle), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this vehicle?" }, class: "bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Assignments and Incidents Section - Only for Managers %>
  <% if current_user.manager? || current_user.admin? %>
    <div class="bg-white shadow-md rounded-lg overflow-hidden mt-6">
      <div class="border-b border-gray-200">
        <nav class="flex -mb-px">
          <button onclick="showTab('assignments')" id="tab-assignments" class="tab-button active w-1/2 py-4 px-1 text-center border-b-2 font-medium text-sm">
            Assignments (<%= @vehicle.assignments.count %>)
          </button>
          <button onclick="showTab('incidents')" id="tab-incidents" class="tab-button w-1/2 py-4 px-1 text-center border-b-2 font-medium text-sm">
            Incidents (<%= @vehicle.incidents.count %>)
          </button>
        </nav>
      </div>

      <%# Assignments Tab Content %>
      <div id="content-assignments" class="tab-content">
        <div class="px-6 py-6">
          <div class="flex justify-end mb-4">
            <%= link_to "Create Assignment", new_company_assignment_path(@company, vehicle_id: @vehicle.id), class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out text-sm" %>
          </div>
          <% assignments = @vehicle.assignments.includes(:driver).order(date: :desc) %>
          <% if assignments.any? %>
            <div class="space-y-4">
              <% assignments.each do |assignment| %>
                <div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50">
                  <div class="flex justify-between items-start">
                    <div>
                      <p class="text-sm font-medium text-gray-900"><%= assignment.date.strftime("%B %d, %Y") %></p>
                      <p class="text-sm text-gray-500">Driver: <%= assignment.driver.name %></p>
                    </div>
                    <%= link_to "View", company_assignment_path(@company, assignment), class: "text-blue-600 hover:text-blue-900 text-sm" %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-gray-500 text-center py-8">No assignments for this vehicle</p>
          <% end %>
        </div>
      </div>

      <%# Incidents Tab Content %>
      <div id="content-incidents" class="tab-content hidden">
        <div class="px-6 py-6">
          <div class="flex justify-end mb-4">
            <%= link_to "Report Incident", new_company_incident_path(@company, vehicle_id: @vehicle.id), class: "bg-orange-600 hover:bg-orange-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-150 ease-in-out text-sm" %>
          </div>
          <% incidents = @vehicle.incidents.includes(:reporter).order(date: :desc) %>
          <% if incidents.any? %>
            <div class="space-y-4">
              <% incidents.each do |incident| %>
                <div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50">
                  <div class="flex justify-between items-start">
                    <div class="flex-1">
                      <div class="flex items-center gap-2 mb-2">
                        <p class="text-sm font-medium text-gray-900"><%= incident.date.strftime("%B %d, %Y") %></p>
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                          <%= case incident.status
                              when 'open' then 'bg-yellow-100 text-yellow-800'
                              when 'in_progress' then 'bg-blue-100 text-blue-800'
                              when 'resolved' then 'bg-green-100 text-green-800'
                              when 'dismissed' then 'bg-gray-100 text-gray-800'
                              end %>">
                          <%= incident.status.humanize %>
                        </span>
                      </div>
                      <p class="text-sm text-gray-900 font-medium"><%= incident.category_name %></p>
                      <p class="text-sm text-gray-500">Reporter: <%= incident.reporter.name %></p>
                      <% if incident.cost.present? && incident.cost > 0 %>
                        <p class="text-sm text-gray-500">Cost: £<%= number_with_precision(incident.cost, precision: 2) %></p>
                      <% end %>
                    </div>
                    <%= link_to "View", company_incident_path(@company, incident), class: "text-orange-600 hover:text-orange-900 text-sm" %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-gray-500 text-center py-8">No incidents for this vehicle</p>
          <% end %>
        </div>
      </div>
    </div>

    <script>
      function showTab(tabName) {
        // Hide all tab contents
        document.querySelectorAll('.tab-content').forEach(content => {
          content.classList.add('hidden');
        });

        // Remove active class from all tabs
        document.querySelectorAll('.tab-button').forEach(button => {
          button.classList.remove('active', 'border-blue-500', 'text-blue-600');
          button.classList.add('border-transparent', 'text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300');
        });

        // Show selected tab content
        document.getElementById('content-' + tabName).classList.remove('hidden');

        // Add active class to selected tab
        const activeTab = document.getElementById('tab-' + tabName);
        activeTab.classList.add('active', 'border-blue-500', 'text-blue-600');
        activeTab.classList.remove('border-transparent', 'text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300');
      }

      // Initialize first tab as active
      document.addEventListener('DOMContentLoaded', function() {
        showTab('assignments');
      });
    </script>

    <style>
      .tab-button {
        transition: all 0.2s;
      }
      .tab-button.active {
        border-color: #3B82F6;
        color: #3B82F6;
      }
      .tab-button:not(.active) {
        border-color: transparent;
        color: #6B7280;
      }
      .tab-button:not(.active):hover {
        color: #374151;
        border-color: #D1D5DB;
      }
    </style>
  <% end %>
</div>
